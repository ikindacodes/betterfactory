{
  "name": "create-betterfactory",
  "version": "0.0.5",
  "description": "Scaffold an open-source eve Software Factory you own — composable like Better T-Stack",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikindacodes/betterfactory.git",
    "directory": "packages/create-betterfactory"
  },
  "homepage": "https://github.com/ikindacodes/betterfactory#readme",
  "bugs": {
    "url": "https://github.com/ikindacodes/betterfactory/issues"
  },
  "bin": {
    "create-betterfactory": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@betterfactory/modules": "workspace:*",
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eve",
    "agent",
    "software-factory",
    "scaffold",
    "betterfactory",
    "create-"
  ]
}
